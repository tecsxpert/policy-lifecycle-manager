# Local development environment variables
# Do not commit real secrets to version control.
# All sensitive configuration should be injected via environment variables

# Database Configuration
# For MySQL/MariaDB: jdbc:mysql://localhost:3306/policydb
# For PostgreSQL: jdbc:postgresql://localhost:5432/policydb
DB_URL=jdbc:h2:mem:testdb
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# Redis Configuration
# Host and port for Redis cache server
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail Configuration
# SMTP credentials for sending emails
MAIL_USERNAME=knowmore089@gmail.com
MAIL_PASSWORD=yourapppassword

# JWT Configuration
# Secret key for JWT token generation and validation (minimum 32 characters recommended)
JWT_SECRET=yourjwtsecretkey0123456789012345
