@baseUrl = http://localhost:8080
@token = eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsImlhdCI6MTc3ODUwNzg4OSwiZXhwIjoxNzc4NTk0Mjg5fQ.3lRqm1WgG9MBsBtCo57vdbw5WoDeAK2_11Eg81h7VsE

### 1. GET all policies WITH JWT
GET {{baseUrl}}/policies
Authorization: Bearer {{token}}

### 2. GET all policies WITHOUT JWT (should return 401)
GET {{baseUrl}}/policies

### 3. CREATE policy WITH JWT
POST {{baseUrl}}/policies
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "policyNumber": "POL003",
  "policyName": "Health Insurance",
  "policyType": "Health",
  "premiumAmount": 5000,
  "startDate": "2024-01-01",
  "endDate": "2025-01-01",
  "status": "ACTIVE"
}

### 4. TEST INVALID ID (should return 404)
GET {{baseUrl}}/policies/999
Authorization: Bearer {{token}}

### 5. TEST INVALID STATUS (should return 400)
POST {{baseUrl}}/policies
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "policyNumber": "POL999",
  "policyName": "Test Policy",
  "policyType": "Test",
  "premiumAmount": 1000,
  "startDate": "2024-01-01",
  "endDate": "2025-01-01",
  "status": "WRONG"
}

### 6. UPLOAD PDF FILE
POST {{baseUrl}}/files/upload
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="test.pdf"
Content-Type: application/pdf

< ../test.pdf
--WebAppBoundary--

### 7. UPLOAD INVALID TXT FILE (should return 400)
POST {{baseUrl}}/files/upload
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="test.txt"
Content-Type: text/plain

< ../test.txt
--WebAppBoundary--

### 8. DOWNLOAD FILE
GET {{baseUrl}}/files/1
Authorization: Bearer {{token}}

### 9. PREVIEW FILE
GET {{baseUrl}}/files/preview/1
Authorization: Bearer {{token}}